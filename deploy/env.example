# kavita-epaper configuration
# Copy this to /opt/kavita-epaper/.env and edit.

# Where the Kavita API lives. Default assumes same host.
# If Kavita runs on a different machine, set this to its internal address
# (e.g. http://10.0.0.50:5000 or http://kavita.lan:5000).
KAVITA_BASE_URL=http://127.0.0.1:5000

# Network binding for the uvicorn process.
#   0.0.0.0 = all interfaces (default; reachable from reverse proxy on another host)
#   127.0.0.1 = loopback only (use if reverse proxy is on the same host)
#   <specific-ip> = bind to a single interface
#KAVITA_EPAPER_HOST=0.0.0.0
#KAVITA_EPAPER_PORT=8095

# Long random string. Used to sign session cookies.
# Generate with: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
KAVITA_EPAPER_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# Cookie name (rarely needs changing).
KAVITA_EPAPER_COOKIE=kesess

# How to set the 'Secure' flag on the session cookie.
#   auto    (default) Set Secure when the request arrived via HTTPS; omit
#                     when HTTP. Same install works for both reverse-proxied
#                     HTTPS access AND direct plain-HTTP access by IP.
#   true              Always set Secure. Pin this if you only ever access via
#                     HTTPS — browsers will refuse the cookie over HTTP.
#   false             Never set Secure. Only useful for testing.
KAVITA_EPAPER_COOKIE_SECURE=auto

# Session lifetime in seconds. Default 30 days.
KAVITA_EPAPER_SESSION_TTL=2592000

# Where to cache pre-rendered covers on disk.
KAVITA_EPAPER_COVER_CACHE=/var/cache/kavita-epaper/covers

# Pre-render covers to grayscale before serving. Big win on e-ink.
# Requires Pillow (installed by default).
KAVITA_EPAPER_GRAYSCALE=true

# Directory where update.sh looks for release tarballs when run with no args.
# `sudo /opt/kavita-epaper/update.sh` will auto-pick the newest
# kavita-epaper-*.tar.gz in this directory. Default: /var/lib/kavita-epaper/releases.
# You can always pass an explicit path or URL to update.sh to bypass this.
#KAVITA_EPAPER_RELEASES_DIR=/var/lib/kavita-epaper/releases
