# kavita-epaper configuration
# install.sh writes this file to /opt/kavita-epaper/.env with a generated
# secret and the Kavita address you gave it. Change the common settings with
#   sudo /opt/kavita-epaper/configure
# or edit that copy and run: systemctl restart kavita-epaper

# Where the Kavita API lives, as this machine reaches it. Default: same host.
# Kavita elsewhere (or in Docker on another machine): its IP and published port,
# e.g. http://10.0.0.50:5000; a sub-path goes at the end (http://10.0.0.50:5000/kavita).
# Change with: configure kavita-url
KAVITA_BASE_URL=http://127.0.0.1:5000

# Private CA for Kavita over HTTPS (PEM). Set with: configure ca-bundle
# See the README's "Kavita over HTTPS" section.
#KAVITA_CA_BUNDLE=/etc/kavita-epaper/kavita-ca.pem

# Check Kavita's TLS certificate (default true; false is not recommended).
# Set with: configure kavita-tls-verify
#KAVITA_TLS_VERIFY=true

# Bind address and port (defaults 0.0.0.0 and 8095, from the service unit).
# 127.0.0.1 = loopback only; see the README's Security section.
#KAVITA_EPAPER_HOST=0.0.0.0
#KAVITA_EPAPER_PORT=8095

# Who may set X-Forwarded-* headers (default *). Set with: configure trusted-proxies
# See the README's Security section.
#KAVITA_EPAPER_FORWARDED_ALLOW_IPS=*

# Session secret, at least 32 characters; install.sh generates it and the app
# won't start without it. New one or rotation: configure new-secret [--keep-sessions]
# See the README's Security section.
KAVITA_EPAPER_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# Old secret during a rotation; set and removed by configure.
#KAVITA_EPAPER_SECRET_PREVIOUS=

# Cookie name (rarely needs changing).
KAVITA_EPAPER_COOKIE=kesess

# Session cookie's Secure flag: auto (default), true or false; what each does is
# in the README's settings table. Set with: configure cookie-secure
KAVITA_EPAPER_COOKIE_SECURE=auto

# Session lifetime in seconds. Default 30 days.
KAVITA_EPAPER_SESSION_TTL=2592000

# Where to cache pre-rendered covers on disk.
KAVITA_EPAPER_COVER_CACHE=/var/cache/kavita-epaper/covers

# Seconds a cached cover is served before it's fetched again (default one day;
# 0 = no disk cache). Covers are cached per user. Set with: configure cover-ttl
#KAVITA_EPAPER_COVER_TTL=86400

# Pre-render covers to grayscale before serving. Big win on e-ink.
# Requires Pillow (installed by default).
KAVITA_EPAPER_GRAYSCALE=true

# Reader keepalive, in seconds. 0 (default) = off. While a reader page is
# visible, the browser requests /ping this often. Turn it on for e-readers
# whose Wi-Fi sleeps between page loads and gets dropped by the access point
# as idle, so the next page load hangs. 25 is a good start. Range 10..300.
# Costs some battery: the radio wakes for every ping.
#KAVITA_EPAPER_KEEPALIVE_SECONDS=0

# Directory where update.sh looks for release tarballs when run with no args.
# `sudo /opt/kavita-epaper/update.sh` will auto-pick the newest
# kavita-epaper-v*.tar.gz in this directory. Default: /var/lib/kavita-epaper/releases.
# You can always pass an explicit path or URL to update.sh to bypass this.
#KAVITA_EPAPER_RELEASES_DIR=/var/lib/kavita-epaper/releases
