# kavita-epaper configuration
# install.sh writes this file to /opt/kavita-epaper/.env with a generated
# secret and the Kavita address you gave it. Edit that copy, then run:
#   systemctl restart kavita-epaper

# Where the Kavita API lives. Default assumes same host.
# If Kavita runs on a different machine, set this to its internal address
# (e.g. http://10.0.0.50:5000 or http://kavita.lan:5000). If Kavita is served
# under a sub-path, include it: http://10.0.0.50:5000/kavita
KAVITA_BASE_URL=http://127.0.0.1:5000

# Kavita over HTTPS with a certificate from a private CA: a PEM file with that
# CA's certificate, trusted in addition to the system CAs. Put it somewhere the
# service can read, e.g. /etc/kavita-epaper/kavita-ca.pem (not under /home or
# /root, which the service can't see).
#KAVITA_CA_BUNDLE=/etc/kavita-epaper/kavita-ca.pem

# Check Kavita's TLS certificate (default true). false turns the check off,
# which lets anything between this app and Kavita read the traffic, passwords
# included. Not recommended; use KAVITA_CA_BUNDLE instead.
#KAVITA_TLS_VERIFY=true

# Network binding for the uvicorn process.
#   0.0.0.0 = all interfaces (default; reachable from reverse proxy on another host)
#   127.0.0.1 = loopback only (use if reverse proxy is on the same host)
#   <specific-ip> = bind to a single interface
#KAVITA_EPAPER_HOST=0.0.0.0
#KAVITA_EPAPER_PORT=8095

# Who may set X-Forwarded-* headers (default *); see the README's Security section.
#KAVITA_EPAPER_FORWARDED_ALLOW_IPS=*

# Long random string, at least 32 characters. Encrypts the session cookie and
# keys the cover cache; kavita-epaper won't start without one. Changing it
# signs everyone out (see KAVITA_EPAPER_SECRET_PREVIOUS).
# Generate with: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
KAVITA_EPAPER_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# To rotate the secret without signing everyone out: put the new value in
# KAVITA_EPAPER_SECRET, the old one here, and restart. Cookies under the old
# secret are accepted and re-issued under the new one. Remove this line after
# KAVITA_EPAPER_SESSION_TTL (30 days by default).
#KAVITA_EPAPER_SECRET_PREVIOUS=

# Cookie name (rarely needs changing).
KAVITA_EPAPER_COOKIE=kesess

# How to set the 'Secure' flag on the session cookie.
#   auto    (default) Set Secure when the request arrived via HTTPS; omit
#                     when HTTP. Same install works for both reverse-proxied
#                     HTTPS access AND direct plain-HTTP access by IP.
#   true              Always set Secure. Pin this if you only ever access via
#                     HTTPS; browsers will refuse the cookie over HTTP.
#   false             Never set Secure. Only useful for testing.
KAVITA_EPAPER_COOKIE_SECURE=auto

# Session lifetime in seconds. Default 30 days.
KAVITA_EPAPER_SESSION_TTL=2592000

# Where to cache pre-rendered covers on disk.
KAVITA_EPAPER_COVER_CACHE=/var/cache/kavita-epaper/covers

# How long a cached cover is served before it is fetched from Kavita again,
# in seconds. Default one day. 0 = no disk cache. Covers are cached per user,
# so one user's cache never serves another.
#KAVITA_EPAPER_COVER_TTL=86400

# Pre-render covers to grayscale before serving. Big win on e-ink.
# Requires Pillow (installed by default).
KAVITA_EPAPER_GRAYSCALE=true

# Reader keepalive, in seconds. 0 (default) = off. While a reader page is
# visible, the browser requests /ping this often. Turn it on for e-readers
# whose Wi-Fi sleeps between page loads and gets dropped by the access point
# as idle, so the next page load hangs. 25 is a good start. Range 10..300.
# Costs some battery: the radio wakes for every ping.
#KAVITA_EPAPER_KEEPALIVE_SECONDS=0

# Directory where update.sh looks for release tarballs when run with no args.
# `sudo /opt/kavita-epaper/update.sh` will auto-pick the newest
# kavita-epaper-*.tar.gz in this directory. Default: /var/lib/kavita-epaper/releases.
# You can always pass an explicit path or URL to update.sh to bypass this.
#KAVITA_EPAPER_RELEASES_DIR=/var/lib/kavita-epaper/releases
